{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "predev": "node scripts/build-content.mjs",
    "prebuild": "node scripts/build-content.mjs",
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"node server/index.mjs\"",
    "web": "vite",
    "api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "screens": "bash scripts/export-screens.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@tailwindcss/vite": "^4.3.4",
    "express": "^5.3.0",
    "openai": "^7.51.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
